# Ruta de la base de datos SQLite local (por defecto ./data/bilifit.db)
BILIFIT_DB_PATH=./data/bilifit.db

# Puerto público en Docker Compose (3000 por defecto; pon 80 para entrar directo por http://192.168.1.47)
BILIFIT_PORT=3000

# Zona horaria del contenedor
TZ=Europe/Madrid

# Credenciales opcionales de la API de Strava (también puedes configurarlas desde la UI en /strava)
# Crea tu app en: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Opcional: fuerza el redirect URI exacto si estás detrás de un proxy o IP fija (ej. http://192.168.1.47:3000/api/strava/callback)
# Si se deja vacío, Bilifit lo deduce automáticamente de la URL actual + /api/strava/callback
STRAVA_REDIRECT_URI=
# Token de verificación para Webhooks de Strava
STRAVA_WEBHOOK_VERIFY_TOKEN=bilifit_webhook_token
