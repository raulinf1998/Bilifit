# Ruta de la base de datos SQLite local (por defecto ./data/bilifit.db)
BILIFIT_DB_PATH=./data/bilifit.db

# Puerto público en Docker Compose (3000 por defecto; pon 80 para entrar directo por http://192.168.1.47)
BILIFIT_PORT=3000

# Zona horaria del contenedor
TZ=Europe/Madrid

# Clave opcional de cifrado AES-256 para credenciales guardadas (si se omite, Bilifit genera una clave local en ./data/.bilifit-secret)
BILIFIT_SECRET=

# Conexión directa nativa con MyWhoosh (opcional; también puedes conectar con email/contraseña desde /ciclismo o /strava)
MYWHOOSH_EMAIL=
MYWHOOSH_PASSWORD=
MYWHOOSH_AUTO_SYNC=0
MYWHOOSH_SYNC_INTERVAL_MIN=15

# Sincronización directa de Huawei Health / Reloj Huawei (carpeta local rclone/Syncthing o Google Drive OAuth)
HUAWEI_SYNC_DIR=/app/data/huawei-sync
HUAWEI_AUTO_SYNC=0
HUAWEI_SYNC_INTERVAL_MIN=15
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Credenciales opcionales de la API de Strava (legado / opcional)
# Crea tu app en: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Opcional: fuerza el redirect URI exacto si estás detrás de un proxy o IP fija (ej. http://192.168.1.47:3000/api/strava/callback)
# Si se deja vacío, Bilifit lo deduce automáticamente de la URL actual + /api/strava/callback
STRAVA_REDIRECT_URI=
# Token de verificación para Webhooks de Strava
STRAVA_WEBHOOK_VERIFY_TOKEN=bilifit_webhook_token
